# Neon pooled PostgreSQL URL (runtime)
DATABASE_URL=
# Neon direct PostgreSQL URL (migrations); defaults to DATABASE_URL
DIRECT_URL=

# Providers: explicit values win; otherwise a configured Gemini key selects Gemini.
TRANSLATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-3.5-flash-lite
TRANSCRIPTION_PROVIDER=gemini
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite

# Natural AI speech: reuses GEMINI_API_KEY (no separate key required).
SPEECH_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore

# Optional OpenAI compatibility. Not used when all providers above are gemini.
# Gemini text translation does not require OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OpenAI speech supports Russian here. Gemini speech supports both Uzbek and Russian.
OPENAI_TTS_VOICE=coral

# Both are required to enable AI routes in production (fail closed otherwise).
# Local npm run dev works without Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Public canonical origin used for same-origin validation
APP_ORIGIN=http://localhost:3000
# Shared anonymous AI request budget per day; protects against cookie rotation.
AI_DAILY_LIMIT=500
